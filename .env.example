# Server-only configuration. Never prefix secrets with VITE_.
# Local mode accepts only loopback hosts/connections. npm start requires protected mode.
ACCESS_MODE=local
# For protected mode: choose a username and a random password of at least 32 characters.
AUTH_USERNAME=
AUTH_PASSWORD=
# Exact HTTPS origin, e.g. https://chat.example.com. No path or trailing slash.
PUBLIC_ORIGIN=
# Security counters only; never conversation history. Keep this file across restarts.
SECURITY_STATE_PATH=.local/security.sqlite
PORT=3001
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
# Leave empty until you explicitly want to use Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FIRST_ACTIVITY_MS=120000
IDLE_MS=60000
OVERALL_MS=300000
RATE_LIMIT=10
HTTP_RATE_LIMIT=120
AUTH_FAILURE_LIMIT=20
# Conservative daily input + maximum-output reservations, separately for each provider.
DAILY_TOKEN_LIMIT=100000
